PORT=4000
FRONTEND_URL=http://localhost:3000
# Server-only secret. Set the real connection string in api/.env or Railway Variables.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=salespace_crm
# Private S3 bucket. Credentials stay on the backend only.
S3_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
S3_REGION=ap-southeast-2
S3_BUCKET=test-learn-didar-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers (default false).
S3_FORCE_PATH_STYLE=false
# WhatsApp Cloud API webhook (backend only; never NEXT_PUBLIC_*).
# Choose a random verify token; copy the App Secret from your Meta application.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
