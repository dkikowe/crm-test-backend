{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBucketExistenceForHead",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::test-learn-didar-bucket"
    },
    {
      "Sid": "ClientFilesOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::test-learn-didar-bucket/clients/*"
    }
  ]
}
